model AttendanceLog {
  id String @id @default(uuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  memberId String
  member   MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  deviceId String?
  device   BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  attendanceType BiometricAttendanceType
  verifyMethod   VerifyMethod @default(FINGERPRINT)

  attendanceTime DateTime

  rawPayload String?

  createdAt DateTime @default(now())

  @@unique([memberId, attendanceTime])
  @@index([businessId])
  @@index([memberId])
  @@index([deviceId])
  @@index([attendanceTime])
  @@index([businessId, attendanceTime])
}
